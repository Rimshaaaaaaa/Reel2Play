# Reel2Play settings. Copy this file to `.env` (repo root) for local runs; never commit a filled-in copy.
# With nothing changed, everything runs locally on the mock model with local file storage.

# --- App -------------------------------------------------------------------------------------
# local | test | production
APP_ENV=local
# Where the web app is served (used for game links and CORS)
WEB_BASE_URL=http://localhost:5173
# Where this API is reachable (used for signed media links with local storage)
API_BASE_URL=http://localhost:8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Signs private media links. Production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-only-change-me
# cron-job.org sends this in the X-Cron-Secret header to POST /internal/cron. Production: a long random string
CRON_SECRET=dev-only-cron-secret
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------------------------
# Local PostgreSQL by default. Production: Neon (neon.tech → project → Connection string,
# then change the scheme to postgresql+psycopg://). Keep ?sslmode=require on Neon URLs.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/reel2play

# --- Media storage ---------------------------------------------------------------------------
# local | supabase
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=var/media
# Supabase (supabase.com → project → Project Settings → API): the project URL and the
# service_role key. Create two buckets: one private, one public.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PRIVATE_BUCKET=reel2play-private
SUPABASE_PUBLIC_BUCKET=reel2play-public
SIGNED_URL_TTL_SECONDS=3600

# --- Models ----------------------------------------------------------------------------------
# mock: recorded answers, no keys needed. live: real endpoints below.
AI_MODE=mock
# data_url sends media inline; signed_url sends signed HTTPS links (use with Supabase)
MEDIA_FOR_MODELS=data_url
# Muse Spark Open on Baseten (baseten.co → API keys). Confirm the model id with
# GET https://inference.baseten.co/v1/models
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SPARK_MODEL_BASETEN=meta-models/muse-spark-open-1026
# Muse Spark Open on Fireworks, the failover (fireworks.ai → API keys)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SPARK_MODEL_FIREWORKS=accounts/fireworks/models/muse-spark-open
# Muse Glimmer served by our Modal app (workers/modal/glimmer.py). The base URL is the URL
# `modal deploy` prints, plus /v1; the key is the Modal proxy token below.
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
# SAM 3.1 cut-out endpoint printed by `modal deploy workers/modal/sam.py`. Empty: the
# fallback cut-out runs instead and marks sprites as lower quality.
SAM_URL=
# SAM 3.1 tracking endpoint for moving sprites (feature 7), printed by the same deploy. Empty:
# the "-segment." address above with "-track." instead, or code follows the product.
SAM_TRACK_URL=
# Modal proxy auth token for our Modal endpoints: "<token id>.<token secret>"
# (Modal dashboard → Settings → Proxy Auth Tokens). Use the same value for GLIMMER_API_KEY.
MODAL_PROXY_TOKEN=
# Play-testing in a Modal Sandbox with no network (feature 57). The API uses a Modal API
# token to start the Sandbox: Modal dashboard → Settings → API Tokens → New Token (or
# `modal token new`, then copy both values from ~/.modal.toml). Empty in development and CI:
# games are then played in a local Chromium (never in production, which refuses to test).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
PLAYTEST_APP=reel2play-playtest
# Runs the play-tester plays per test, and fix rounds before a person is asked to look
TESTER_RUNS=3
MAX_FIX_ROUNDS=3
# Cost meter: rupees per US dollar
USD_TO_PKR=280

# --- Publishing ------------------------------------------------------------------------------
# Game links are <SHARE_BASE_URL>/g/<code>. Empty: the API's own address (API_BASE_URL).
SHARE_BASE_URL=
# Gameplay Reel: frames per second of game time, and pixels per CSS pixel (2 → 720 x 1280)
REEL_FPS=20
REEL_SCALE=2
# Unique win codes (feature 40): on by default. A cap per game per day, and per phone per ten
# minutes (the phone's address is only hashed in memory, never stored).
UNIQUE_COUPONS=true
COUPONS_PER_AD_PER_DAY=2000
COUPONS_PER_VISITOR=5
# Easier versions (feature 44): after this many plays, if fewer than this share reach the end
# or fewer than this share of finishers win, one easier version is made for the owner to try.
EASIER_VERSIONS=true
EASIER_AFTER_PLAYS=30
EASIER_BELOW_COMPLETION=0.5
EASIER_BELOW_WINS=0.4
# Batch mode (feature 46): products in one batch upload
MAX_BATCH_ITEMS=12
# MCP endpoint (feature 52): ads an AI assistant may order per hour from one address
MCP_ADS_PER_HOUR=10
# Template marketplace (feature 49): the Reel2Play team's key for reviewing designers'
# templates (header X-Admin-Key). Any long random string you choose; empty turns review off.
ADMIN_KEY=

# --- WhatsApp Cloud API (feature 2) ------------------------------------------------------------
# Meta for Developers → your app → WhatsApp → API Setup: the access token and the test number's
# "Phone number ID". App settings → Basic: the App secret (it signs every webhook). The verify
# token is any long random string you choose; type the same one in the webhook settings, with
# the callback URL https://<your API>/webhooks/whatsapp, and subscribe to "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Offers on WhatsApp (feature 43): the business number players write to, digits only with the
# country code (the number on API Setup, like 15551234567). Empty turns sign-ups off.
WHATSAPP_BUSINESS_NUMBER=
GRAPH_API_VERSION=v26.0

# --- Instagram and Facebook import (feature 3) -----------------------------------------------
# Meta for Developers → the same app → add "Facebook Login for Business". App settings → Basic:
# App ID and App secret. Facebook Login → Settings → Valid OAuth Redirect URIs:
# https://<your API>/api/import/meta/callback. While the app is in development mode only its
# admins and testers can sign in, which is enough for the demo.
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration ID (it then replaces the scopes)
META_LOGIN_CONFIG_ID=

# --- Jobs ------------------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1.0
JOB_STALE_AFTER_SECONDS=900

# --- Upload limits ---------------------------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=180
MAX_PHOTOS=6
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Web app (read by Vite at build time; put these in web/.env) ------------------------------
# VITE_API_BASE_URL=http://localhost:8000
